# Base URL for the ASP.NET PreconIQ API (include scheme and port)
# Example for local HTTPS launch from Visual Studio: https://localhost:7069
REACT_APP_API_BASE_URL=https://localhost:7069

# Entra ID / MSAL configuration
REACT_APP_MSAL_CLIENT_ID=5f0fa384-2bb0-421e-9141-08ec2eb34c67
REACT_APP_MSAL_API_CLIENT_ID=2dbc60cd-9e28-44df-b213-b216b05fff01
REACT_APP_MSAL_TENANT_ID=78d53608-54ca-4a74-8beb-8a1399c1189c
REACT_APP_MSAL_REDIRECT_URL=http://localhost:3000

# CI/CD convenience: if your pipeline exposes these variables they will be copied into the
# REACT_APP_* keys by scripts/prepare-env.js:
# - PRECONIQAPIURL
# - MSAL_CLIENT_ID
# - MSAL_API_CLIENT_ID
# - AZURE_TENANT_ID (or MSAL_TENANT_ID)
# - MSAL_REDIRECT_URL (or SWAGGER_REDIRECT_URL)
