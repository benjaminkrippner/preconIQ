# Base URL for the ASP.NET PreconIQ API (include scheme and port)
# Example for local HTTPS launch from Visual Studio: https://localhost:7132
REACT_APP_API_BASE_URL=https://localhost:7132

# Entra ID / MSAL configuration
REACT_APP_MSAL_CLIENT_ID=<spa-client-id>
REACT_APP_MSAL_API_CLIENT_ID=<api-app-id>
REACT_APP_MSAL_TENANT_ID=<tenant-id>
REACT_APP_MSAL_REDIRECT_URL=http://localhost:3000

# CI/CD convenience: if your pipeline exposes these variables they will be copied into the
# REACT_APP_* keys by scripts/prepare-env.js:
# - PRECONIQAPIURL
# - MSAL_CLIENT_ID
# - MSAL_API_CLIENT_ID
# - AZURE_TENANT_ID (or MSAL_TENANT_ID)
# - MSAL_REDIRECT_URL (or SWAGGER_REDIRECT_URL)
